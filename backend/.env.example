# Copy this file to .env and fill in real values. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-your-key-here


# Optional. If set, the agent treats this as "today" instead of the real
# clock -- used to keep demo scenarios deterministic. Leave unset for normal use.
# MOCK_TODAY=2026-08-12

# Optional overrides, sensible defaults if unset.
# ANTHROPIC_MODEL=claude-sonnet-5
# MAX_AGENT_STEPS=8
