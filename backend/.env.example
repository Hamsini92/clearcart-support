# Copy this file to .env and fill in real values. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for voice (Whisper speech-to-text + TTS). Not needed for text chat.
OPENAI_API_KEY=sk-your-openai-key-here


# If set, the agent treats this as "today" instead of the real clock --
# keeps the return-window math in the README's example scenarios reproducing
# the exact documented outcomes, regardless of what day this is actually run.
# In a real deployment this would be unset, so the agent uses the live clock.
MOCK_TODAY=2026-08-12

# Optional overrides, sensible defaults if unset.
# ANTHROPIC_MODEL=claude-sonnet-5
# MAX_AGENT_STEPS=8

# Demo/testing only -- simulates a transient order-lookup failure so the
# retry path is visible in the admin dashboard instead of relying on real
# flakiness. Unset in normal use.
# DEMO_FAIL_FIRST_ORDER_LOOKUP=true          # fails ORD-1001's first lookup, then recovers
# SIMULATE_TOOL_FAILURE_ORDER_ID=ORD-1001    # same idea, any order_id
# SIMULATE_TOOL_FAILURE_MODE=always          # fails every time instead of just once
